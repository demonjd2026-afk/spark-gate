BASETEN_API_KEY=          # Muse Spark Open on Baseten
FIREWORKS_API_KEY=        # Muse Spark Open on Fireworks
GLIMMER_BASE_URL=         # OpenAI-compatible endpoint serving Muse Glimmer 30B (e.g. Modal)
GLIMMER_API_KEY=
